@model List<CinemaManagement.MVC.ViewModels.MovieViewModel>
@{
    ViewData["Title"] = "Quản lý phim";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách phim</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm phim</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên phim</th>
            <th>Đạo diễn</th>
            <th>Thời lượng</th>
            <th>Thể loại</th>
            <th>Trạng thái</th>
            <th style="width:180px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.MovieID</td>
                <td>@m.Title</td>
                <td>@m.Director</td>
                <td>@m.Duration phút</td>
                <td>@m.GenreName</td>
                <td>
                    @if (m.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@m.MovieID" class="btn btn-sm btn-warning">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@m.MovieID" method="post" class="d-inline"
                          onsubmit="return confirm('Xóa phim này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
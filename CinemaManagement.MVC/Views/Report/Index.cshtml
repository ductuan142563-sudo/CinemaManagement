@using CinemaManagement.MVC.ViewModels
@model ReportSummaryViewModel
@{
    ViewData["Title"] = "Báo cáo";
}

<h2 class="mb-3">Báo cáo tổng quan</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="small">Tổng doanh thu</div>
                <div class="fs-4 fw-bold">@ReportFormat.Money(Model.TotalRevenue)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <div class="small">Doanh thu hôm nay</div>
                <div class="fs-4 fw-bold">@ReportFormat.Money(Model.TodayRevenue)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-warning h-100">
            <div class="card-body">
                <div class="small">Tổng số vé đã bán</div>
                <div class="fs-4 fw-bold">@ReportFormat.Number(Model.TotalTickets)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-bg-info h-100">
            <div class="card-body">
                <div class="small">Tổng thành viên</div>
                <div class="fs-4 fw-bold">@ReportFormat.Number(Model.TotalMembers)</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Revenue" class="btn btn-outline-primary">Báo cáo doanh thu theo ngày</a>
    <a asp-action="TopMovies" class="btn btn-outline-primary">Phim bán chạy</a>
</div>
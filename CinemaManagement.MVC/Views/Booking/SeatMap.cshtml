@model CinemaManagement.MVC.ViewModels.BookingPageViewModel
@{
    ViewData["Title"] = "Chọn ghế";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div id="bookingRoot"
     data-showtime-id="@Model.ShowtimeId"
     data-discount-percent="@(Model.Member?.DiscountPercent ?? 0)"
     data-vnd-per-point="@Model.VndPerPoint">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <a asp-action="Index" class="btn btn-link px-0">&larr; Chọn suất khác</a>
    <h3 id="movieTitle" class="mb-0">Đang tải...</h3>
    <p id="showtimeInfo" class="text-muted"></p>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="screen">MÀN HÌNH</div>
            <div id="seatGrid" class="seat-grid"></div>

            <div class="seat-legend mt-3">
                <span><i class="seat available"></i> Ghế trống</span>
                <span><i class="seat selected"></i> Đang chọn</span>
                <span><i class="seat booked"></i> Đã đặt</span>
            </div>
        </div>

        <div class="col-lg-4">
            @if (Model.IsMember && Model.Member != null)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">Thành viên</h6>
                        <div>Mã: <strong>@Model.Member.MembershipCode</strong></div>
                        <div>Hạng: <strong>@Model.Member.TierName</strong> (giảm @Model.Member.DiscountPercent%)</div>
                        <div>Điểm hiện tại: <strong>@Model.Member.CurrentPoints.ToString("N0")</strong></div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Ghế đã chọn</h6>
                    <div id="selectedSeats" class="mb-3 text-muted">Chưa chọn ghế</div>

                    <dl class="row mb-0">
                        <dt class="col-6">Tổng tiền</dt>
                        <dd class="col-6 text-end" id="totalAmount">0đ</dd>
                        <dt class="col-6">Giảm giá</dt>
                        <dd class="col-6 text-end text-success" id="discountAmount">0đ</dd>
                        <dt class="col-6">Điểm sẽ nhận</dt>
                        <dd class="col-6 text-end" id="pointsEarned">0</dd>
                        <dt class="col-6 fs-5">Thành tiền</dt>
                        <dd class="col-6 text-end fs-5 fw-bold" id="finalAmount">0đ</dd>
                    </dl>
                    <div class="form-text mb-3" id="estimateNote"></div>

                    <button id="btnBook" class="btn btn-primary w-100" disabled>Thanh toán</button>
                    <div id="bookingMessage" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
@using CinemaManagement.MVC.Helpers
@using CinemaManagement.MVC.ViewModels
@inject IConfiguration Config
@model BookingIndexViewModel
@{
    ViewData["Title"] = "Đặt vé";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/poster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/movie-page.css" asp-append-version="true" />
}

<div class="mb-4">
    <h2 class="mb-1">Đặt vé</h2>
    <p class="text-muted mb-0">Chọn một phim để xem suất chiếu và đặt ghế.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <p class="mb-0">Hiện chưa có phim nào đang chiếu.</p>
    </div>
}
else
{
    <div class="movie-grid">
        @foreach (var card in Model.Items)
        {
            var m = card.Movie;
            var src = PosterHelper.Resolve(Config, m.PosterUrl);

            <article class="movie-card @(card.HasShowtimes ? "" : "movie-card--off")">
                <a class="movie-card__link" asp-controller="Booking" asp-action="Movie" asp-route-id="@m.MovieID"
                   aria-label="Xem suất chiếu phim @m.Title">
                    <div class="poster @(src != null ? "poster--img" : "")" style="--hue:@card.PosterHue">
                        @if (src != null)
                        {
                            <img class="poster__img" src="@src" alt="Poster phim @m.Title" loading="lazy"
                                 onerror="this.parentElement.classList.remove('poster--img'); this.remove();" />
                        }
                        @if (!string.IsNullOrWhiteSpace(m.AgeRating))
                        {
                            <span class="poster__age">@m.AgeRating</span>
                        }
                        <div class="poster__title" aria-hidden="true">@m.Title</div>
                    </div>
                    <h3 class="movie-card__title">@m.Title</h3>
                </a>

                <div class="movie-card__meta">
                    @if (!string.IsNullOrWhiteSpace(m.GenreName))
                    {
                        <span>@m.GenreName</span>
                    }
                    <span>@m.Duration phút</span>
                </div>

                @if (card.HasShowtimes)
                {
                    <span class="movie-card__hint">Chọn suất chiếu</span>
                }
                else
                {
                    <span class="movie-card__hint movie-card__hint--off">Chưa có suất chiếu</span>
                }
            </article>
        }
    </div>
}
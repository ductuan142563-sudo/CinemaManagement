@model List<CinemaManagement.MVC.ViewModels.MovieOptionViewModel>
@{
    ViewData["Title"] = "Đặt vé";
}

<h2 class="mb-3">Đặt vé</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <label for="movieSelect" class="form-label">1. Chọn phim</label>
        <select id="movieSelect" class="form-select">
            <option value="">-- Chọn phim --</option>
            @foreach (var m in Model)
            {
                <option value="@m.MovieId">@m.Title</option>
            }
        </select>
    </div>
    <div class="col-md-8">
        <label class="form-label">2. Chọn suất chiếu</label>
        <div id="showtimeList" class="list-group">
            <div class="text-muted">Hãy chọn phim để xem suất chiếu.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const fmtMoney = v => Number(v).toLocaleString('vi-VN') + 'đ';

        document.getElementById('movieSelect').addEventListener('change', async function () {
            const box = document.getElementById('showtimeList');
            box.replaceChildren();
            if (!this.value) { box.textContent = 'Hãy chọn phim để xem suất chiếu.'; return; }

            box.textContent = 'Đang tải...';
            try {
                const res = await fetch('/Booking/Showtimes?movieId=' + encodeURIComponent(this.value));
                const json = await res.json();
                box.replaceChildren();
                if (!json.success) { box.textContent = json.message; return; }
                if (json.data.length === 0) { box.textContent = 'Phim này chưa có suất chiếu sắp tới.'; return; }

                json.data.forEach(s => {
                    const a = document.createElement('a');
                    a.className = 'list-group-item list-group-item-action d-flex justify-content-between';
                    a.href = '/Booking/SeatMap?showtimeId=' + s.showtimeId;
                    const t = new Date(s.startTime).toLocaleString('vi-VN');
                    a.innerHTML = '<span></span><span class="text-muted"></span>';
                    a.children[0].textContent = t + ' — ' + s.hallName;
                    a.children[1].textContent = 'Giá từ ' + fmtMoney(s.basePrice);
                    box.appendChild(a);
                });
            } catch {
                box.textContent = 'Không tải được suất chiếu.';
            }
        });
    </script>
}
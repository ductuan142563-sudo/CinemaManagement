@using CinemaManagement.MVC.Helpers
@{
    var isLoggedIn = SessionHelper.IsLoggedIn(Context.Session);
    var role = SessionHelper.GetRole(Context.Session);
    var fullName = SessionHelper.GetFullName(Context.Session) ?? SessionHelper.GetUsername(Context.Session);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Cinema Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (isLoggedIn)
                        {
                            @if (role == "Admin")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Movie" asp-action="Index">Phim</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Showtime" asp-action="Index">Suất chiếu</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Đặt vé</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Profile">Thành viên</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Report" asp-action="Index">Báo cáo</a></li>
                            }
                            else if (role == "Staff")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Showtime" asp-action="Index">Suất chiếu</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Đặt vé</a></li>
                            }
                            else if (role == "Member")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Đặt vé</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Profile">Hồ sơ</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-light me-3">Xin chào, @fullName</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center">
            &copy; 2026 - Cinema Management
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>